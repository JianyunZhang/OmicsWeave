{
  "$defs": {
    "DatasetMeta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "omics": {
          "$ref": "#/$defs/Omics"
        },
        "tissue": {
          "title": "Tissue",
          "type": "string"
        },
        "value_type": {
          "$ref": "#/$defs/ValueType"
        },
        "scale": {
          "enum": [
            "linear",
            "log2"
          ],
          "title": "Scale",
          "type": "string"
        },
        "normalization": {
          "default": "none",
          "title": "Normalization",
          "type": "string"
        },
        "feature_id_type": {
          "title": "Feature Id Type",
          "type": "string"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "source": {
          "additionalProperties": true,
          "title": "Source",
          "type": "object"
        }
      },
      "required": [
        "omics",
        "tissue",
        "value_type",
        "scale",
        "feature_id_type"
      ],
      "title": "DatasetMeta",
      "type": "object"
    },
    "ExchangeArtifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "table",
            "dataset_metadata",
            "matrix",
            "features"
          ],
          "title": "Kind",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "size",
        "sha256"
      ],
      "title": "ExchangeArtifact",
      "type": "object"
    },
    "ExchangeDataset": {
      "additionalProperties": false,
      "properties": {
        "directory": {
          "title": "Directory",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/DatasetMeta"
        }
      },
      "required": [
        "directory",
        "metadata"
      ],
      "title": "ExchangeDataset",
      "type": "object"
    },
    "ExchangeLineage": {
      "additionalProperties": false,
      "properties": {
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        },
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "parent_run_id": {
          "title": "Parent Run Id",
          "type": "string"
        },
        "parent_manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Parent Manifest Sha256",
          "type": "string"
        },
        "source_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Run Id"
        },
        "source_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Manifest Sha256"
        },
        "lineage_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Lineage Sha256",
          "type": "string"
        }
      },
      "required": [
        "trial_id",
        "intent",
        "parent_run_id",
        "parent_manifest_sha256",
        "lineage_sha256"
      ],
      "title": "ExchangeLineage",
      "type": "object"
    },
    "ExchangeRun": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "omicsweave_version": {
          "title": "Omicsweave Version",
          "type": "string"
        },
        "bundle_schema_version": {
          "title": "Bundle Schema Version",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "config_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Sha256"
        }
      },
      "required": [
        "project_id",
        "experiment_id",
        "run_id",
        "created_at",
        "omicsweave_version",
        "bundle_schema_version",
        "manifest_sha256"
      ],
      "title": "ExchangeRun",
      "type": "object"
    },
    "Omics": {
      "enum": [
        "transcriptomics",
        "proteomics",
        "metabolomics",
        "mfa"
      ],
      "title": "Omics",
      "type": "string"
    },
    "ValueType": {
      "enum": [
        "counts",
        "tpm",
        "intensity",
        "peak_area",
        "concentration",
        "mid_fraction",
        "flux",
        "derived"
      ],
      "title": "ValueType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "omicsweave.analysis-result.exchange",
      "title": "Format",
      "type": "string"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "run": {
      "$ref": "#/$defs/ExchangeRun"
    },
    "lineage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExchangeLineage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/ExchangeDataset"
      },
      "title": "Datasets",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ExchangeArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "format",
    "version",
    "run",
    "datasets",
    "artifacts"
  ],
  "title": "AnalysisResultExchange",
  "type": "object"
}
